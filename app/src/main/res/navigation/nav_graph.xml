<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.haircare.navigation.fragments.WelcomeFragment"
        android:label="@string/app_name">

        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />

        <action
            android:id="@+id/action_welcome_to_register"
            app:destination="@id/registerFragment" />

    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.haircare.navigation.fragments.LoginFragment"
        android:label="@string/login">

        <action
            android:id="@+id/action_login_to_recovery"
            app:destination="@id/recoveryFragment" />

        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.haircare.navigation.fragments.RegisterFragment"
        android:label="@string/register_title" />

    <fragment
        android:id="@+id/recoveryFragment"
        android:name="com.example.haircare.navigation.fragments.RecoveryFragment"
        android:label="@string/recovery_title" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.haircare.navigation.fragments.HomeFragment"
        android:label="@string/home">

        <action
            android:id="@+id/action_home_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

    </fragment>

</navigation>