<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recuperar contraseña"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Introduce tu correo electrónico para solicitar la recuperación de tu cuenta."
            android:textSize="16sp"
            android:textColor="#795548"
            android:gravity="center"
            android:layout_marginBottom="35dp" />

        <EditText
            android:id="@+id/etEmailRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/btnSendRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitar recuperación"
            android:textColor="#FFFFFF"
            android:backgroundTint="#795548"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnBackLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio de sesión"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A1887F" />

    </LinearLayout>
</ScrollView>
