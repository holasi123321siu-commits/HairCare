<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery_description"
            android:textSize="16sp"
            android:textColor="#795548"
            android:gravity="center"
            android:layout_marginBottom="35dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmailRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:layout_marginBottom="25dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmailRecovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSendRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery"
            android:textColor="#FFFFFF"
            android:backgroundTint="#795548"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnBackLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_login"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A1887F" />

    </LinearLayout>
</ScrollView>